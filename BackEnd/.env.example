# === Servidor ===
PORT=3001

# Origen del FrontEnd permitido por CORS (Next.js)
FRONTEND_URL=http://localhost:3000

# === Supabase ===
# URL del proyecto (Settings -> API -> Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave anon / publishable (Settings -> API -> Project API keys -> anon public).
# NO uses la service_role aquí: el BackEnd actúa en nombre del usuario vía Supabase Auth,
# que se encarga de emitir y validar los JWT.
SUPABASE_KEY=your-anon-public-key

# === Cloudinary ===
# Subida de imágenes (avatares, etc.). La key/secret SOLO viven en el BackEnd;
# el FrontEnd nunca las conoce (envía el archivo a este API y el API sube a Cloudinary).
# Settings -> API Keys en el dashboard de Cloudinary.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# === Apps Script (envío de correos: códigos de 2FA) ===
# Web App de Google Apps Script (MailApp) que envía los correos. URL termina en /exec.
# El secreto es una cadena aleatoria que también se guarda en el Script Property SHARED_SECRET.
# El correo sale de la cuenta de Gmail dueña del script (deployá el script desde la
# cuenta que querés como remitente, p. ej. una cuenta dedicada del marketplace).
APPS_SCRIPT_URL=https://script.google.com/macros/s/xxxx/exec
APPS_SCRIPT_SECRET=your-shared-secret

# === Apariencia de los correos ===
# Nombre que se muestra como remitente (From) en los correos.
EMAIL_FROM_NAME=FWD Marketplace
# Logo de cabecera: URL HTTPS pública a una imagen PNG/JPG (los correos NO renderizan SVG).
# El asset vive en FrontEnd/public/fwd-logo.png. Ojo: las URL de raw.githubusercontent.com
# NO se rinden en Gmail (su proxy de imágenes las bloquea). Usá una de estas:
#   Vercel (producción):  https://<tu-dominio>.vercel.app/fwd-logo.png
#   Supabase Storage:     https://<proj>.supabase.co/storage/v1/object/public/<bucket>/fwd-logo.png
#   weserv (proxy CDN):   https://images.weserv.nl/?url=raw.githubusercontent.com/<owner>/<repo>/<rama>/FrontEnd/public/fwd-logo.png
# Si se deja vacío, la plantilla usa un wordmark de texto "FWD." como fallback.
EMAIL_LOGO_URL=