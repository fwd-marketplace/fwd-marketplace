{
  "info": {
    "name": "FWD Marketplace - Pruebas de tokens",
    "description": "Colección para verificar los tipos de tokens (access_token, refresh_token) y el comportamiento de las rutas protegidas del BackEnd. Antes de usar: levantar el BackEnd (npm run dev) y rellenar las variables anonKey y supabaseUrl desde el dashboard de Supabase.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api" },
    { "key": "supabaseUrl", "value": "https://grwzmemhazeahaiyectt.supabase.co" },
    { "key": "anonKey", "value": "" },
    { "key": "email", "value": "tu-usuario@gmail.com" },
    { "key": "password", "value": "tu-password" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/register", "host": ["{{baseUrl}}"], "path": ["users", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"Usuario Prueba\"\n}"
            },
            "description": "Crea el usuario en Supabase Auth. Si el proyecto exige confirmacion por email, la respuesta trae session=null (sin tokens) hasta confirmar."
          }
        },
        {
          "name": "2. Login (guarda tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.session) {",
                  "  pm.collectionVariables.set('accessToken', d.session.access_token);",
                  "  pm.collectionVariables.set('refreshToken', d.session.refresh_token);",
                  "}",
                  "pm.test('login 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/login", "host": ["{{baseUrl}}"], "path": ["users", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Devuelve session con access_token (JWT, ~1h) y refresh_token. El test script los guarda en las variables de la coleccion."
          }
        },
        {
          "name": "3. Me (con access_token valido)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] },
            "description": "Ruta protegida. Con un access_token valido devuelve el usuario (200)."
          }
        },
        {
          "name": "4. Me (SIN token) -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] },
            "description": "Sin cabecera Authorization el middleware responde 401."
          }
        },
        {
          "name": "5. Me (token INVALIDO) -> 401",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer token.falso.123" }],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] },
            "description": "Con un token invalido Supabase lo rechaza y el middleware responde 401."
          }
        },
        {
          "name": "6. Refresh token (Supabase directo)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/auth/v1/token?grant_type=refresh_token",
              "host": ["{{supabaseUrl}}"],
              "path": ["auth", "v1", "token"],
              "query": [{ "key": "grant_type", "value": "refresh_token" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "description": "Usa el refresh_token para emitir un access_token NUEVO sin volver a pedir password. Se llama directo a Supabase porque el BackEnd aun no tiene endpoint /users/refresh."
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Listado (con token)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] },
            "description": "Listado protegido. El BackEnd reenvia el token a Postgres para que el RLS filtre por usuario."
          }
        },
        {
          "name": "Listado (SIN token) -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] },
            "description": "Sin token, 401."
          }
        },
        {
          "name": "Detalle (con token)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/projects/:id", "host": ["{{baseUrl}}"], "path": ["projects", ":id"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Detalle de un proyecto por id (UUID). 404 si no existe o no es visible."
          }
        }
      ]
    }
  ]
}
