# === Servidor ===
PORT=3001

# Origen del FrontEnd permitido por CORS (Next.js)
FRONTEND_URL=http://localhost:3000

# === Supabase ===
# URL del proyecto (Settings -> API -> Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave anon / publishable (Settings -> API -> Project API keys -> anon public).
# NO uses la service_role aquí: el BackEnd actúa en nombre del usuario vía Supabase Auth,
# que se encarga de emitir y validar los JWT.
SUPABASE_KEY=your-anon-public-key