# === Servidor ===
PORT=3001

# Origen del FrontEnd permitido por CORS (Next.js)
FRONTEND_URL=http://localhost:3000

# === Supabase ===
# URL del proyecto (Settings -> API -> Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave anon / publishable (Settings -> API -> Project API keys -> anon public).
# NO uses la service_role aquí: el BackEnd actúa en nombre del usuario vía Supabase Auth,
# que se encarga de emitir y validar los JWT.
SUPABASE_KEY=your-anon-public-key

# === Cloudinary ===
# Subida de imágenes (avatares, etc.). La key/secret SOLO viven en el BackEnd;
# el FrontEnd nunca las conoce (envía el archivo a este API y el API sube a Cloudinary).
# Settings -> API Keys en el dashboard de Cloudinary.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# === Apps Script (envío de correos: códigos de 2FA) ===
# Web App de Google Apps Script (MailApp) que envía los correos. URL termina en /exec.
# El secreto es una cadena aleatoria que también se guarda en el Script Property SHARED_SECRET.
APPS_SCRIPT_URL=https://script.google.com/macros/s/xxxx/exec
APPS_SCRIPT_SECRET=your-shared-secret

# === IA (Asistente para crear proyectos) ===
# Proveedor principal: Groq, vía su endpoint compatible con OpenAI.
# Sacá la key en https://console.groq.com/keys (free tier, empieza con gsk_...).
# La key vive SOLO aquí, en el BackEnd: nunca en el FrontEnd ni en el bundle del cliente.
GROQ_API_KEY=your-groq-api-key

# Config del proveedor (si se omiten, se usan estos valores por defecto).
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
# AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES=2

# --- Fallback opcional a Google Gemini (desactivado por defecto) ---
# Poné AI_FALLBACK_ENABLED=true y una GEMINI_API_KEY para que, si Groq falla,
# se reintente con Gemini (también por endpoint compatible con OpenAI).
# AI_FALLBACK_ENABLED=false
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-2.5-flash